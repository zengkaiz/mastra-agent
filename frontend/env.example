# ============================================
# 环境变量配置
# ============================================
# 注意：Vite 环境变量必须以 VITE_ 开头才能在客户端代码中访问

# GraphQL API 端点 URL
# ============================================
# 本地开发环境（Vite 会通过 proxy 转发请求）
VITE_GRAPHQL_ENDPOINT=http://localhost:8787/graphql

# 生产环境示例（部署 Worker 后替换为实际 URL）
# VITE_GRAPHQL_ENDPOINT=https://mastra-interview-worker.your-subdomain.workers.dev/graphql

# ============================================
# 如何设置环境变量：
# ============================================
#
# 1. 本地开发：
#    复制此文件为 .env
#    cp env.example .env
#
# 2. Cloudflare Pages（Git 集成）：
#    在 Cloudflare Dashboard > Pages > 项目设置 > 环境变量
#    添加变量：VITE_GRAPHQL_ENDPOINT
#
# 3. Direct Upload 部署：
#    创建 .env 文件并设置生产环境 URL
#    构建前确保环境变量正确

